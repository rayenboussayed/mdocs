{
  "name": "mdocs",
  "version": "1.0.0",
  "description": "Vite-style CLI wrapper around jsdoc-to-markdown: generate one typed Markdown API doc per source file from JSDoc, with src and dist line pointers.",
  "type": "module",
  "bin": {
    "mdocs": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.17"
  },
  "keywords": [
    "jsdoc",
    "markdown",
    "api",
    "docs",
    "documentation",
    "jsdoc2md",
    "cli",
    "jsdoc-to-markdown",
    "typescript"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run knip && npm run test",
    "bench": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest bench --config test/bench/vitest.config.ts --reporter=verbose",
    "bench:memory": "NODE_OPTIONS=--expose-gc NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest run --config test/bench/vitest.config.ts --reporter=verbose",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . --cache",
    "build": "tsc -p tsconfig.json && node -e \"const{readFileSync,writeFileSync,chmodSync}=require('node:fs');const p='dist/cli.js';const b=readFileSync(p,'utf8');if(!b.startsWith('#!'))writeFileSync(p,'#!/usr/bin/env node\\n'+b);chmodSync(p,0o755)\"",
    "test": "npm run build && vitest run --coverage",
    "clean": "node -e \"const { rmSync } = require('node:fs'); for (const dir of ['dist', '.test-dist']) rmSync(dir, { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run check",
    "prepack": "npm run clean && npm run build",
    "knip": "knip",
    "prepare": "husky",
    "lint:fix": "eslint . --fix --cache",
    "types:sync": "node scripts/sync-jsdoc-to-markdown-types.mjs"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "commander": "^15.1.0",
    "jsdoc-to-markdown": "^9.1.3",
    "jutilities": "^1.3.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@deslint/eslint-plugin": "^0.10.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-jsdoc": "^65.4.7",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
